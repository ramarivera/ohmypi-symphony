{
  "name": "ohmypi-linear-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts src/extensions/report-deviation.ts src/workspace-worker.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bunx --bun vitest run",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@linear/sdk": "89.0.0",
    "@oh-my-pi/pi-coding-agent": "17.1.8",
    "effect": "4.0.6",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@effect/vitest": "4.0.6",
    "@types/bun": "^1.3.14",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "@effect/tsgo": "0.56.0"
  }
}
