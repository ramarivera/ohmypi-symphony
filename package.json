{
  "name": "ohmypi-linear-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "@linear/sdk": "88.3.0",
    "@oh-my-pi/pi-coding-agent": "17.1.8",
    "effect": "^3.22.1",
    "pino": "^10.3.1"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@effect/language-service": "^0.87.1",
    "@effect/vitest": "^0.30.0",
    "@types/bun": "^1.3.14",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
